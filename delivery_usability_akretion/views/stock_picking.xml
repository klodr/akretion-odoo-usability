<odoo>

<record id="view_picking_withcarrier_out_form" model="ir.ui.view">
    <field name="name">delivery_usability.stock.picking.form</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock_delivery.view_picking_withcarrier_out_form"/>
    <field name="arch" type="xml">
        <!-- Sometimes we have to modify carrier_id when state is done:
        remove the readonly on state done/cancel from the view and
        add tracking on the field definition -->
        <field name="carrier_id" position="attributes">
            <attribute name="readonly">0</attribute>
        </field>
    </field>
</record>

</odoo>
